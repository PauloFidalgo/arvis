# riscv-gcc-hwloop: GCC with -mhwloop support (no fused instructions)
# Builds on top of riscv-gcc-prebuilt (binutils + newlib + stage1 ready)
#
# Usage:
#   docker build -t riscv-gcc-hwloop .

FROM riscv-gcc-prebuilt

COPY gcc_hwloop_hooks.c /work/gcc_hwloop_hooks.c
COPY gcc_hwloop_md.md /work/gcc_hwloop_md.md
COPY gcc_apply_hwloop.sh /work/gcc_apply_hwloop.sh

RUN bash /work/gcc_apply_hwloop.sh

# Smoke test
RUN echo 'int f(int n){int s=0;for(int i=0;i<n;i++)s+=i;return s;}' > /tmp/t.c && \
    /opt/riscv/bin/riscv32-unknown-elf-gcc -march=rv32imc -mabi=ilp32 -O2 -mhwloop -S -o /tmp/t.s /tmp/t.c && \
    grep -q 'bnez' /tmp/t.s && echo "SMOKE TEST: PASS" || echo "SMOKE TEST: FAIL"

CMD ["/opt/riscv/bin/riscv32-unknown-elf-gcc"]
