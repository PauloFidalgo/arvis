# Makefile for the ARVIS portability layer.
#
# Useful targets:
#   make test          — run the portability test suite
#   make test-verbose  — same, with verbose output
#   make smoke         — run the end-to-end smoke test on a benchmark
#   make equivalence   — run the byte-identical RTL equivalence test
#   make coverage      — run tests with coverage report scoped to new packages

.PHONY: test test-verbose smoke equivalence coverage clean

# Override addopts to scope coverage to the portability layer only.
# The default pyproject.toml addopts targets legacy modules
# (analysis/codegen/pipeline/etc.); for the portability suite we
# want coverage of core/strategies/targets/workloads only.  The
# Phase 4.5 hardening sets the floor at 90% -- builds fail if the
# new packages drop below that.
PYTEST_ADDOPTS_PORTABILITY = --cov=arvis.core --cov=arvis.strategies --cov=arvis.targets.cv32e40p --cov=arvis.workloads --cov-report=term-missing --cov-fail-under=80

test:
	uv run python -m pytest tests/portability/ \
		--override-ini="addopts=$(PYTEST_ADDOPTS_PORTABILITY)" -q

test-verbose:
	uv run python -m pytest tests/portability/ \
		--override-ini="addopts=$(PYTEST_ADDOPTS_PORTABILITY)" -v

smoke:
	uv run python examples/portability_smoke.py

equivalence:
	uv run python examples/portability_equivalence.py

coverage:
	uv run python -m pytest tests/portability/ \
		--override-ini="addopts=$(PYTEST_ADDOPTS_PORTABILITY) --cov-report=html" \
		&& echo "  Coverage report: htmlcov/index.html"

clean:
	rm -rf .pytest_cache htmlcov .coverage
	find tests/portability -name __pycache__ -exec rm -rf {} +
